# Copy to .env and fill in. All configuration is via environment variables.

# Dedicated Pixelfed account the robot posts as (bare host, no scheme).
# pixelfed.social is meenow's home instance (see meenow-dev/src/config.ts) —
# keep the robot there so its posts are local to the community and can be
# archived like everyone else's.
MEENOW_PIXELFED_INSTANCE=pixelfed.social
# Access token for that account (scopes: write; follow is only needed to manage
# followers, which is done from the meenow app / Pixelfed UI, not here).
MEENOW_PIXELFED_TOKEN=

# Optional IANA timezone for the daily trigger. Leave unset to use the host's
# local time (matches a co-located meenow PWA on the same machine).
# MEENOW_TZ=Europe/Berlin

# Optional caption prepended above the #meenowApp tag.
# MEENOW_CAPTION=Hello from Reachy Mini

# How many minutes after the trigger a (possibly delayed) post may still fire.
# Matches meenow's 2h push window. Set to 0 to always post on entering an
# unposted period.
# MEENOW_CATCHUP_MINUTES=120

# Dev toggles.
# MEENOW_DRY_RUN=true    # log the post instead of sending; token not required
# MEENOW_POST_NOW=true   # fire one capture immediately, ignoring the schedule
# Camera. By default the app captures directly from the local camera device
# (the daemon releases it) and auto-detects the Reachy Mini video node — no
# configuration needed on the robot host.
# MEENOW_CAMERA_DEVICE=/dev/video0  # override the auto-detected device
                                # (a /dev/videoN path or a numeric index)
# MEENOW_CAMERA_FOURCC=MJPG     # pixel format to request (default MJPG for colour;
                                # empty leaves the driver default)
# MEENOW_CAMERA_RESOLUTION=1920x1080  # capture resolution (empty leaves as-is)
# MEENOW_MEDIA_BACKEND=default  # use the SDK's WebRTC/LOCAL media stream instead
                                # of direct capture (default is "no_media")
# MEENOW_ALLOW_SYNTHETIC=true   # allow the placeholder frame in a real post
                                # (for testing posting without a camera)
# Mirror-selfie pose (the turn-and-tilt before the second capture).
# MEENOW_MIRROR_YAW_DEG=-90     # body/head yaw; negative turns right, positive left
# MEENOW_MIRROR_PITCH_DEG=10    # head tilt; positive looks down, negative up
# MEENOW_MIRROR_FLIP=true       # horizontally un-mirror the selfie
# MEENOW_SELFIE_ZOOM=1.0        # digital zoom on the selfie (center-crop, >=1)
# Head teach mode (needs the daemon on --kinematics-engine Placo): hold BOTH
# antennas down to make the head soft, move it by hand, then raise the antennas
# to store that pose as the new neutral (the pose it returns to after a selfie).
# MEENOW_HEAD_TEACH=true        # set false to disable teach mode
# MEENOW_HEAD_TEACH_TIMEOUT_S=10  # idle time in teach mode before the head
                                # drifts back to the old neutral (pose discarded)
# Clock-antenna capture: the bot's RIGHT antenna is a clock hand. 12 o'clock is
# the resting (up) pose; wind it counter-clockwise down to an hour (11, 10, 9,
# 8...) and hold it still for a moment, and it ticks back up to 12 once per
# second (five ticks per hour) — the photo is taken when it reaches 12. Winding
# to 8 o'clock is a 20-second countdown. Pushing it back down cancels. The left
# antenna stays up, so BOTH antennas down still means teach (see above).
# MEENOW_CLOCK=true             # set false to fall back to the one-antenna tap
# MEENOW_CLOCK_TICK_S=1         # seconds per tick (5 ticks per clock hour)
# MEENOW_CLOCK_UP_DEG=-10       # the 12 o'clock angle; unset uses the SDK up pose
# Antenna gestures: one antenna = capture now, both = teach (see above). Only
# used as the capture trigger when MEENOW_CLOCK is false.
# MEENOW_TOUCH_TRIGGER=true     # set false to disable antenna gestures
# MEENOW_TOUCH_THRESHOLD_DEG=20 # how far a push counts as an antenna deflection
# MEENOW_STATE_FILE=/path/to/state.json  # override the persisted state location
# MEENOW_SAVE_DIR=./captures    # also save each capture's back/front/composite
                                # JPEGs into a timestamped subfolder (inspect
                                # shots without posting; pairs with DRY_RUN).
                                # When set, the app serves the newest composite
                                # on localhost (see MEENOW_VIEWER_PORT).
# MEENOW_VIEWER_PORT=8899       # capture viewer port (localhost only)

# --- Voice commands (left antenna push-to-talk -> smart-home flows) ---------
# Hold the LEFT antenna down: the robot beeps and records. Release it: the
# audio is transcribed (German), an LLM picks the matching flow from the flow
# builder's ListFlows, fires it via POST /flow/<name> and speaks a short
# German reply. Requires the mic/speaker to be free (the default no_media
# backend releases them). Needs whisper.cpp built (see README).
# MEENOW_VOICE=true             # master switch (default off)
# MEENOW_FLOWS_URL=http://raspi.fritz.box:8080  # flow builder base URL
# LLM: any OpenAI-compatible chat-completions endpoint.
# MEENOW_LLM_BASE_URL=http://localhost:11436/v1
# MEENOW_LLM_MODEL=mistral-small-latest
# MEENOW_LLM_API_KEY=           # only if the endpoint needs one
# Speech-to-text: whisper_cpp (resident whisper-server, default) |
#                 whisper_cli (one-shot subprocess) | mistral (Voxtral).
# MEENOW_STT_PROVIDER=whisper_cpp
# If nothing answers /health here, the app starts whisper-server itself and
# stops it on exit. Defaults point at the whisper.cpp checkout next to this
# repo (../whisper.cpp); override if it lives elsewhere.
# MEENOW_WHISPER_SERVER_URL=http://127.0.0.1:8180
# MEENOW_WHISPER_SERVER_BIN=/path/to/whisper.cpp/build/bin/whisper-server
# MEENOW_WHISPER_CPP_BIN=/path/to/whisper.cpp/build/bin/whisper-cli
# MEENOW_WHISPER_MODEL=/path/to/whisper.cpp/models/ggml-large-v3-turbo-german.bin
# MEENOW_WHISPER_LANG=de
# MEENOW_WHISPER_THREADS=8
# MEENOW_MISTRAL_API_KEY=       # STT provider "mistral"; also used for the
#                               # LLM automatically when LLM_BASE_URL is api.mistral.ai
# MEENOW_MISTRAL_STT_MODEL=voxtral-mini-2602  # Voxtral Mini Transcribe 2
# Full-Mistral setup (no local whisper): MEENOW_STT_PROVIDER=mistral,
# MEENOW_LLM_BASE_URL=https://api.mistral.ai/v1, MEENOW_LLM_MODEL=ministral-14b-2512
# Text-to-speech: local piper CLI + a German voice model. Unset voice = the
# robot only beeps instead of speaking.
# MEENOW_PIPER_BIN=piper
# MEENOW_PIPER_VOICE=/path/to/de_DE-thorsten-medium.onnx
# MEENOW_VOICE_MAX_RECORD_S=15  # hard cap on one recording
# Audio devices (PortAudio indices from python -m sounddevice; empty = default)
# MEENOW_AUDIO_INPUT_DEVICE=
# MEENOW_AUDIO_OUTPUT_DEVICE=
